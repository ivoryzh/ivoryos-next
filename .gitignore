# Real device credentials written at runtime by setup_broker() when an AWS IoT CLOUD_TOKEN is
# configured (the device certificate + private key) — never commit these, they're per-device
# secrets, not source.
edge_server/ivoryos_edge/.certs/
# The Cloud daemon's own AWS IoT Thing certificate + private key (see .env.local.example's
# AWS_IOT_CA_PATH/AWS_IOT_CERT_PATH/AWS_IOT_KEY_PATH) — a real, privileged secret, not source.
cloud_frontend/certs/
# *.pem below doesn't actually cover the two directories above's contents: private keys are .key,
# and the downloaded root CA is .crt.
*.key
*.crt

# Python
__pycache__/
.pytest_cache/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# A bare, unscoped "lib/" line used to live here and silently matched (and dropped from git
# entirely, with no warning) cloud_frontend/src/lib/ — a real source directory, nothing to do
# with Python packaging. It's not missed: build/ already covers a setuptools build/lib/ output
# dir on its own, and .venv/ / venv/ below already cover a real virtualenv's lib/ subdirectory.
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/

# Node
node_modules/
.pnp
.pnp.js
coverage/
.next/
out/
.DS_Store
*.pem

# IDE
.idea/
.vscode/
*.swp
*.swo

# Local SQLite
*.db
# SQLite's WAL sidecars — created since the workflow store enabled WAL (see models.py).
*.db-shm
*.db-wal
*.sqlite3

# Auto-dumped on every edge server startup (server.py's startup_event) for local inspection —
# pure regenerated output, not source; was previously tracked and just churned as diff noise.
# NOT cloud_frontend/public/ivoryos_schema.json — that one IS real, fetched at runtime by
# cloud_frontend/src/app/edge-sequence/page.tsx as a static demo fixture, so it stays tracked.
/ivoryos_schema.json
/example/ivoryos_schema.json

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Append-only workflow version snapshots. Local runtime state, like the SQLite DB above — the
# committed workflows/*.json files are the heads; every past save lives here and is regenerated
# lazily (see ensure_versioned in edge_server/ivoryos_edge/workflows.py).
edge_server/ivoryos_edge/workflows/.versions/
# Workflow tags — local bookkeeping alongside the versions above, not protocol content.
edge_server/ivoryos_edge/workflows/.meta.json

# Agent provider settings — endpoint, model, and possibly an API key. Runtime state that lives
# beside the workflow store (see agent/routes.py), never something to commit.
edge_server/ivoryos_edge/agent_settings.json
# One lab's limits and interlocks, written by the Safety page.
edge_server/ivoryos_edge/safety.json
edge_server/ivoryos_edge/safety_state.json

# Desktop app (desktop/): its own node_modules, the resources prepare-resources.js assembles for
# packaging (a uv binary, the edge wheel, a copy of frontend/out), and electron-builder output.
desktop/node_modules/
desktop/resources/
desktop/dist/
# ...but desktop/build/ is electron-builder's input folder (the app icon and its source logo),
# which the Python `build/` rule above would otherwise swallow.
!desktop/build/

# One edge per data folder (edge_server/ivoryos_edge/instance_lock.py)
.ivoryos_edge.lock

# Per-edge state for the flow-lab example (example/flow_lab/): each edge's database, workflows
# and .env -- which holds its Cloud pairing token -- live here at runtime (IVORYOS_EDGE_HOME).
example/flow_lab/.edges/
example/liquid_handler/.edge/
