# Copy to .env.local. Both the Next.js app and daemon.js (via dotenv) load this file directly —
# nothing extra needed to run either one.
#
# ---------------------------------------------------------------------------------------------
# MODE: local (LAN) vs cloud (hosted)
# ---------------------------------------------------------------------------------------------
# local — a lab on a LAN. SQLite file (ivoryos_cloud.db) + the broker the daemon starts itself.
#         No accounts, no keys, no Docker, no broker to install, no internet. THIS IS THE DEFAULT:
#         leave SUPABASE_URL unset and both the app and the daemon just run.
# cloud — the hosted product. Supabase + AWS IoT Core (or any remote broker).
#
# The mode is inferred from SUPABASE_URL: set => cloud, unset => local. Setting only one of the
# two SUPABASE_* vars below is a fatal error rather than a silent fallback.
# IVORYOS_CLOUD_MODE=local|cloud overrides the inference — use it in a real deploy, where quietly
# writing to a local SQLite file nobody reads would be the wrong way to fail.
# IVORYOS_CLOUD_MODE=

# Where the LAN-mode database lives. Defaults to cloud_frontend/ivoryos_cloud.db. Set this to the
# same ABSOLUTE path for both processes if you start them from different directories — otherwise
# they can end up on two different files, which /api/health will tell you about explicitly.
# IVORYOS_LOCAL_DB=

# Cloud's own Supabase project (separate from the Hub's — see supabase/migrations/).
# LEAVE BOTH BLANK FOR LOCAL/LAN MODE.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- daemon.js broker connection: pick ONE of the two blocks below ---

# Local/dev MQTT broker — no TLS, no per-device cert. You do NOT need to install one: in LAN mode
# the daemon starts a broker in-process on this port and binds 0.0.0.0, so devices elsewhere on
# the LAN can reach it. A loopback host here means "the broker is on this machine", never "refuse
# the LAN". If something else already holds the port (a real mosquitto, say) the daemon defers to
# it and logs which it chose. Point this at another machine and the embedded broker stays off.
# IVORYOS_EMBEDDED_BROKER=0 disables it outright; =1 forces it on for a non-local bind address.
MQTT_BROKER_URL=mqtt://127.0.0.1:1883

# AWS IoT Core (production) — mutual TLS. If AWS_IOT_ENDPOINT is set, the daemon uses this block
# and ignores MQTT_BROKER_URL. The cert/key here are the *daemon's own* AWS IoT Thing credentials
# (a Thing representing the Cloud backend itself, not any one edge device — it needs its own,
# broader IoT policy allowing it to subscribe across every device's topics, not the per-device
# ThingName-scoped policy — see AGENTS.md's Cloud section for both policy JSONs).
# AWS_IOT_ENDPOINT=xxxxxxxxxxxxx-ats.iot.us-east-1.amazonaws.com
# AWS_IOT_CA_PATH=./certs/root-CA.crt
# AWS_IOT_CERT_PATH=./certs/daemon.cert.pem
# AWS_IOT_KEY_PATH=./certs/daemon.private.key
# MUST exactly match the AWS IoT Thing name the certificate above is attached to. Get this wrong
# (or leave it unset — the fallback is a random string) and the daemon silently hangs forever: it
# connects fine at the TCP/TLS level since the cert itself is valid, but the policy's iot:Connect
# permission is scoped to ${iot:Connection.Thing.ThingName}, so AWS IoT never sends a CONNACK for
# a mismatched client ID — no error, just silence. Confirmed by inspecting open sockets directly:
# TLS was ESTABLISHED, on('connect') never fired.
# MQTT_CLIENT_ID=ivoryos-cloud-daemon

MQTT_TOPIC_PREFIX=ivoryos/edge

# --- api/devices/provision (src/lib/aws-iot.ts): mints a per-device Thing + cert automatically ---
# Same AWS_IOT_ENDPOINT as above. AWS_IOT_POLICY_NAME must already exist (create it once by hand
# in the AWS console — see AGENTS.md's Cloud section for the exact policy JSON) before this route
# can attach it to a new device's certificate.
AWS_REGION=us-east-1
AWS_IOT_POLICY_NAME=ivoryos-edge-device-policy
# Credentials for the AWS SDK — a dedicated IAM user scoped to ONLY: iot:CreateThing,
# iot:CreateKeysAndCertificate, iot:AttachPolicy, iot:AttachThingPrincipal, iot:UpdateCertificate,
# iot:DeleteCertificate, iot:DeleteThing. Not an admin user — this key lives in a server-side env
# var and provisioning is reachable by anyone who can hit this Next.js app until real auth exists.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
